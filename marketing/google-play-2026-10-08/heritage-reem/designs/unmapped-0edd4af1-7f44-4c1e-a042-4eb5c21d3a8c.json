and-assets/talia-official-logo/logo_new.png\" \n        alt=\"Talia Logo\" \n        class=\"h-[64px] w-auto object-contain\" \n        id=\"header-logo\"\n      >\n    </div>\n\n    <!-- Headlines Section -->\n    <div class=\"absolute top-[175px] right-[90px] w-[900px] flex flex-col items-start text-right z-50\" id=\"headline-container\">\n      <h1 class=\"text-[86px] leading-[1.3] font-bold text-[#3D3425] tracking-tight\" id=\"main-headline\">\n        كن قريبًا<br>من رحلته\n      </h1>\n      <div class=\"w-[60px] h-[2px] bg-[#C4A365]/60 mt-8 mb-6\" id=\"gold-divider\"></div>\n      <p class=\"text-[34px] text-[#3D3425]/80 font-medium\" id=\"sub-headline\">\n        تابع تقدّم طفلك من لوحة ولي الأمر على الجهاز\n      </p>\n    </div>\n\n    <!-- Image Composition Area -->\n    <div class=\"absolute inset-0 z-10\">\n      <!-- Secondary Image (Right, Behind) -->\n      <div class=\"absolute right-[-60px] top-[940px] w-[400px] rotate-[-8deg] z-10\" id=\"secondary-img-wrapper\">\n        <img \n          src=\"https://vgbujcuwptvheqijyjbe.supabase.co/storage/v1/object/public/hmac-uploads/projects/1e8d0a36-f2e3-4302-b966-9a9a009d58e9/content-assets/1919313fb4cd44b98ff296f091f2b29bdfaac0cc65d1745c5096887377a6a519/53-current-kids.png\" \n          alt=\"Kids Selection Screen\" \n          class=\"w-full h-auto rounded-[22px] screenshot-shadow border-white/40 border-[1px]\"\n          id=\"img-kids-selection\"\n        >\n      </div>\n\n      <!-- Primary Image (Center, Dominant) -->\n      <div class=\"absolute left-[225px] top-[640px] w-[660px] rotate-[3deg] z-20\" id=\"primary-img-wrapper\">\n        <img \n          src=\"https://vgbujcuwptvheqijyjbe.supabase.co/storage/v1/object/public/hmac-uploads/projects/1e8d0a36-f2e3-4302-b966-9a9a009d58e9/content-assets/7a2db48ec8ff93f0280c202682ff372ecd2468725aa4bef91b4f20107ef40971/69-child-detail.png\" \n          alt=\"Parent Dashboard Detail\"\n          class=\"w-full h-auto rounded-[22px] screenshot-shadow border-white/50 border-[1.5px]\"\n          id=\"img-dashboard\"\n        >\n      </div>\n    </div>\n\n    <!-- Bottom Brand Identity -->\n    <div class=\"absolute bottom-[80px] left-1/2 -translate-x-1/2 flex items-center gap-4 z-50\" id=\"bottom-brand\">\n      <div class=\"h-[1px] w-[40px] bg-[#3D3425]/20\"></div>\n      <span class=\"text-[24px] font-bold text-[#3D3425]/60 tracking-[0.1em]\">تالية القرآن</span>\n      <div class=\"h-[1px] w-[40px] bg-[#3D3425]/20\"></div>\n    </div>\n\n    <!-- Final Softening Gradient -->\n    <div class=\"absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,_transparent_0%,_rgba(255,252,242,0.15)_100%)]\"></div>\n  </div>\n</body>\n</html>",
