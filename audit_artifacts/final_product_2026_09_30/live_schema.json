  "tables": [
    {
      "name": "public.profiles",
      "rls_enabled": true,
      "columns": [
        {
          "name": "id",
          "format": "uuid"
        },
        {
          "name": "display_name",
          "format": "text",
          "check": "char_length(display_name) <= 100"
        },
        {
          "name": "avatar_url",
          "format": "text",
          "check": "avatar_url IS NULL OR char_length(avatar_url) <= 500"
        },
        {
          "name": "age",
          "format": "int4",
          "check": "age IS NULL OR age >= 1 AND age <= 150"
        },
        {
          "name": "created_at",
          "format": "timestamptz"
        },
        {
          "name": "updated_at",
          "format": "timestamptz"
        },
        {
          "name": "selected_path",
          "format": "text",
          "check": "selected_path IS NULL OR (selected_path = ANY (ARRAY['adult'::text, 'child'::text]))"
        },
        {
          "name": "guardian_onboarding_status",
          "format": "text",
          "check": "guardian_onboarding_status IS NULL OR (guardian_onboarding_status = ANY (ARRAY['required'::text, 'skipped'::text, 'completed'::text]))"
        },
        {
          "name": "is_parent_guardian",
          "format": "bool"
        },
        {
          "name": "child_nickname",
          "format": "text",
          "check": "child_nickname IS NULL OR char_length(child_nickname) >= 1 AND char_length(child_nickname) <= 50 AND child_nickname = btrim(child_nickname) AND child_nickname !~ '[[:cntrl:]]'::text"
        }
      ],
      "primary_keys": [
        "id"
      ]
    },
