<?xml version="1.0" encoding="utf-8"?>
<!-- The adhan clips are resolved by name at runtime (notification channel
     sound and Resources.getIdentifier in the prayer delivery plugin), which
     the release resource shrinker cannot see. Without this rule every
     release build ships without them and the adhan is silent. The media
     notification icon is also resolved by name by audio_service. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/adhan,@raw/adhan_*,@drawable/ic_notification" />
