<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup or device-to-device transfer of app data.
     A restore would bring back the local database and preferences without
     the keystore-bound secure-storage keys and account owner mapping they
     depend on, leaving account data unreadable or attributed to the wrong
     owner, and would copy the auth session into the backup. Signed-in users
     move devices through cloud sync instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
